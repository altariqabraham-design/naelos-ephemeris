// build_lunar_mean.mts — keeps the mean North Node and mean Lilith honest beyond 1550–2650.
//
//   npx tsx tools/build_lunar_mean.mts /path/to/far-tables/
//
// The mean node and mean apogee come from the mean elements of the lunar
// theory (Meeus ch. 47, ELP2000-82B): polynomials in time, accurate near the
// present and drifting away from it — against the true points of DE441,
// averaged over their cycles, the mean node is 2.4° out by 13,000 BC and the
// mean apogee 2.4° by AD 16,000. A "mean" point is meant to be the true one
// with its oscillations smoothed away, so this measures the drift directly:
// every CORR_STEP years it averages (true − polynomial) over a 100-year window
// of DE441, where every periodic term of the node and apogee (the longest are
// 18.6 and 8.85 years) averages out, and writes the result as a correction
// table. The engine applies it only outside the DE440 tables, blended in as
// the long-term frame is, so no chart from 1550 to 2650 changes.
//
// Reads data/ and the far tables (the 289 not in git; pass their folder).
// Writes src/generated/lunar-mean.ts.

import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const root = new URL("../", import.meta.url);
const { NaelosEphemeris, tablesFor, julday, SE_MEAN_NODE, SE_TRUE_NODE, SE_MEAN_APOG, SE_OSCU_APOG, FIRST_JD, LAST_JD } =
  await import(new URL("src/index.ts", root).href);
const { iauWeight } = await import(new URL("src/frames.ts", root).href);
const { meanCorrection } = await import(new URL("src/lunar-points.ts", root).href);

const NEAR = fileURLToPath(new URL("data/", root));
const FAR = process.argv[2];
if (!FAR) throw new Error("pass the folder holding every far table");
const nearNames = new Set(readdirSync(NEAR));
const read = (n: string) => readFileSync((nearNames.has(n) ? NEAR : FAR) + "/" + n);

const CORR_STEP = 100; // years between corrections
const WINDOW = 100 * 365.25; // days averaged for each
const SAMPLES = 20000;
const wrap = (d: number) => ((d + 540) % 360) - 180;

// The correction is wanted only where the engine uses it; inside the DE440
// tables it is zero by construction. Sample from just inside the tables'
// first window to just inside their last.
const first = Math.ceil((2000 + (FIRST_JD + WINDOW / 2 - 2451545) / 365.25) / CORR_STEP) * CORR_STEP;
const last = Math.floor((2000 + (LAST_JD - WINDOW / 2 - 2451545) / 365.25) / CORR_STEP) * CORR_STEP;

// Only the centuries one window needs: decoded, all 306 would take about 900 MB.
const ready = (from: number, to: number) => NaelosEphemeris.fromBuffers(tablesFor(from, to).map(read));

// The engine's mean points already carry the correction table in the tree;
// adding it back measures against the bare polynomial, so rerunning this on
// the same tables writes the same table.
function meanOffset(e: InstanceType<typeof NaelosEphemeris>, trueId: number, meanId: number, mid: number): number {
  let sx = 0, sy = 0;
  for (let i = 0; i < SAMPLES; i++) {
    const t = mid - WINDOW / 2 + (WINDOW * (i + 0.5)) / SAMPLES;
    const a = e.calc(t, trueId, 0), b = e.calc(t, meanId, 0);
    if ("error" in a || "error" in b) throw new Error(`no position at TT ${t}`);
    const applied = meanId === SE_MEAN_NODE ? meanCorrection(t).node : meanCorrection(t).apogee;
    const d = (wrap(a.longitude - b.longitude + applied) * Math.PI) / 180;
    sx += Math.cos(d);
    sy += Math.sin(d);
  }
  return (Math.atan2(sy, sx) * 180) / Math.PI;
}

const years: number[] = [], node: number[] = [], apogee: number[] = [];
for (let y = first; y <= last; y += CORR_STEP) {
  const mid = 2451545 + (y - 2000) * 365.25;
  if (iauWeight(mid) === 1) { years.push(y); node.push(0); apogee.push(0); continue; } // inside 1550–2650
  const e = ready(mid - WINDOW / 2 - 2, mid + WINDOW / 2 + 2);
  years.push(y);
  node.push(meanOffset(e, SE_TRUE_NODE, SE_MEAN_NODE, mid));
  apogee.push(meanOffset(e, SE_OSCU_APOG, SE_MEAN_APOG, mid));
  if (y % 1000 === 0) console.log(`${y}: node ${node.at(-1)!.toFixed(4)}°, apogee ${apogee.at(-1)!.toFixed(4)}°`);
}

const fmt = (a: number[]) => a.map((v) => v.toFixed(5)).join(",");
const out = fileURLToPath(new URL("src/generated/lunar-mean.ts", root));
writeFileSync(out, `// GENERATED by tools/build_lunar_mean.mts — do not edit. Rerun the tool instead.
//
// Corrections to the mean North Node and mean Lilith beyond the DE440 tables:
// the true node and the true (osculating) apogee of DE441, averaged over 100
// years, minus the mean-element polynomial — degrees, every ${CORR_STEP} years from
// epoch ${first} to ${last}. Zero across 1550–2650, where the engine does not use them.

export const LUNAR_MEAN_FROM_EPOCH = ${first};
export const LUNAR_MEAN_STEP_YEARS = ${CORR_STEP};
// prettier-ignore
export const MEAN_NODE_CORRECTION = [${fmt(node)}] as const;
// prettier-ignore
export const MEAN_APOGEE_CORRECTION = [${fmt(apogee)}] as const;
`, "utf8");
console.log(`wrote ${years.length} corrections, ${first} .. ${last}; node ${Math.min(...node).toFixed(3)}..${Math.max(...node).toFixed(3)}°, apogee ${Math.min(...apogee).toFixed(3)}..${Math.max(...apogee).toFixed(3)}°`);
